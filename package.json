{
  "name": "rosid-handler-sass",
  "version": "9.0.1",
  "description": "Load SASS and transform to CSS, add vendor prefixes and minify",
  "keywords": [
    "rosid",
    "handler",
    "transform",
    "compile",
    "sass",
    "scss",
    "postcss",
    "autoprefixer",
    "cssnano"
  ],
  "homepage": "https://github.com/electerious/rosid-handler-sass",
  "repository": {
    "type": "git",
    "url": "https://github.com/electerious/rosid-handler-sass.git"
  },
  "license": "MIT",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "eslint": "eslint \"**/*.js\"",
    "format": "npm run eslint -- --fix && npm run prettier -- --write",
    "lint": "npm run eslint && npm run prettier -- --check",
    "prettier": "prettier --ignore-path .gitignore \"**/*.{js,json,md,yml}\"",
    "test": "npm run lint && node --test"
  },
  "dependencies": {
    "autoprefixer": "^10.4.27",
    "cssnano": "^7.1.4",
    "postcss": "^8.5.8",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "@electerious/eslint-config": "^5.2.2",
    "@electerious/prettier-config": "^4.0.1",
    "eslint": "^9.39.4",
    "fsify": "^6.0.2",
    "prettier": "^3.8.1"
  },
  "authors": [
    "Tobias Reich <tobias@electerious.com>"
  ]
}
